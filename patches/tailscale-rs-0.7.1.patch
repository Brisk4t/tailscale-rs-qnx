+/// The rustls crypto provider used for all TLS connections.
+///
+/// aws-lc-rs everywhere except QNX, which uses ring (aws-lc-sys doesn't build with qcc). The
+/// provider is passed explicitly rather than relying on rustls's process-wide default, so the
+/// choice doesn't depend on which rustls provider features other crates in the build enable.
+static CRYPTO_PROVIDER: LazyLock<Arc<CryptoProvider>> = LazyLock::new(|| {
+    #[cfg(not(target_os = "qnx"))]
+    let provider = tokio_rustls::rustls::crypto::aws_lc_rs::default_provider();
+    #[cfg(target_os = "qnx")]
+    let provider = tokio_rustls::rustls::crypto::ring::default_provider();
+    Arc::new(provider)
+});
+
+#[cfg_attr(not(feature = "insecure"), allow(dead_code))]
+pub(crate) fn crypto_provider() -> &'static Arc<CryptoProvider> {
+    &CRYPTO_PROVIDER
+}
+
+/// A [`ClientConfig`] builder using [`CRYPTO_PROVIDER`] and rustls's safe default protocol
+/// versions (the same versions `ClientConfig::builder()` picks).
+pub(crate) fn client_config_builder() -> std::io::Result<ConfigBuilder<ClientConfig, WantsVerifier>>
+{
+    ClientConfig::builder_with_provider(CRYPTO_PROVIDER.clone())
+        .with_safe_default_protocol_versions()
+        .map_err(std::io::Error::other)
+}
