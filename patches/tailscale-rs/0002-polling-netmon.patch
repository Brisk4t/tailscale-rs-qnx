+        InterfaceId::new(MonType::POLLING, index)
+    }
+
+    fn iface(index: u64, name: &str, up: bool) -> Interface {
+        Interface {
+            id: id(index),
+            up,
+            name: name.to_owned(),
+            mtu: None,
+            hardware_addr: None,
+            metric_v4: 0,
